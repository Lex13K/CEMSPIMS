# Virtual environments
.venv/
venv/

# Build / packaging
build/
dist/
*.egg-info/
app/web/node_modules/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test / coverage (local)
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Type checker / profiler (if used)
.dmypy.json
dmypy.json
*.prof

# Artifacts (project-specific output root, if created)
artifacts/

# Local data: shared root + per-run outputs (gitignored except structure markers)
data/*
!data/shared/
data/shared/**
!data/shared/raw/
data/shared/raw/*
!data/shared/raw/.gitkeep
!data/shared/interim/
data/shared/interim/**
!data/shared/interim/.gitkeep

# Editor / IDE (machine-specific)
.cursor/
.idea/
*.code-workspace

# Jupyter
.ipynb_checkpoints/

# Environment and secrets (never commit credentials)
.env
.env.*
!.env.example

# Logs and local scratch
*.log
*.tmp
*.temp

# OS
.DS_Store
Thumbs.db
Desktop.ini
